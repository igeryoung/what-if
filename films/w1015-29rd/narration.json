  {"at": 32.2, "text": "The laptop."},
  {"at": 34.2, "text": "The TV."},
  {"at": 36.2, "text": "The whole table."},
  {"at": 38.2, "text": "Wait. Isn't that just a tiger?"},
  {"at": 40.6, "text": "Their genomes are 95.6 percent alike."},
